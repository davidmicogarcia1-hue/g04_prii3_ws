<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>g04_prii3_nav_turtlebot</name>
  <version>0.0.0</version>

  <description>
    Navegacion autonoma del TurtleBot3 para el proyecto PRII3.
  </description>

  <maintainer email="davidmicogarcia1@gmail.com">david</maintainer>

  <license>TODO: License declaration</license>


  <!-- Dependencias de ROS2 -->
  <depend>rclpy</depend>

  <!-- Mensajes para poses y coordenadas -->
  <depend>geometry_msgs</depend>

  <!-- Mensajes de la camara -->
  <depend>sensor_msgs</depend>

  <!-- Conversion entre imagen ROS y OpenCV -->
  <depend>cv_bridge</depend>

  <!-- Accion NavigateToPose de Navigation2 -->
  <depend>nav2_msgs</depend>

  <!-- Estados de las acciones ROS2 -->
  <depend>action_msgs</depend>


  <!-- Dependencias para tests -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>


  <export>
    <build_type>ament_python</build_type>
  </export>

</package>
